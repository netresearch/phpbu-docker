{
    "name": "netresearch/phpbu-docker-full",
    "description": "Docker container for phpbu - full variant with all sync adapters",
    "type": "project",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "Tobias Hein",
            "email": "tobias.hein@netresearch.de"
        },
        {
            "name": "Norman Golatka",
            "email": "norman.golatka@netresearch.de"
        }
    ],
    "require": {
        "php": ">=8.5",
        "phpbu/phpbu": "^6.0.32",
        "aws/aws-sdk-php": "^3.10",
        "google/cloud-storage": "^2.0",
        "azure-oss/storage": "^2.0",
        "phpseclib/phpseclib": "^3.0",
        "sebastianfeldmann/ftp": "^0.9.2",
        "kunalvarma05/dropbox-php-sdk": "^0.5",
        "guzzlehttp/guzzle": "^7.5",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
